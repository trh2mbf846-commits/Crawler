# Alle Variablen optional, Präfix CRAWLER_ (siehe app/config.py).
# CRAWLER_DATABASE_URL=sqlite:///data/ausschreibungscrawler.db
# CRAWLER_ANTHROPIC_API_KEY=
# CRAWLER_ANTHROPIC_MODEL=claude-sonnet-5
# Ohne gesetzten Wert bleibt die API offen (Entwicklungs-Default) - für ein echtes Deployment
# setzen und denselben Wert im Frontend als VITE_API_KEY hinterlegen (siehe app/security.py).
# CRAWLER_API_KEY=
# CRAWLER_RANKING_WEIGHT_KI_RELEVANZ=0.4
# CRAWLER_RANKING_WEIGHT_DRINGLICHKEIT=0.3
# CRAWLER_RANKING_WEIGHT_PROFIL=0.2
# CRAWLER_RANKING_WEIGHT_AKTUALITAET=0.1
